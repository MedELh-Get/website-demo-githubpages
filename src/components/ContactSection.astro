---
// Replace this URL with your LinkedIn profile URL.
const linkedinUrl = "https://www.linkedin.com/in/mohamed-el-404468206/";
const email = "contact@mohstack.com";
interface Props { githubUrl?: string; }
const { githubUrl = "https://github.com" } = Astro.props;
---

<section id="contact" class="ms-contact" aria-labelledby="contact-heading">
  <div class="container ms-contact-inner">
    <div class="ms-contact-copy">
      <p class="eyebrow">LET’S WORK TOGETHER</p>
      <h2 id="contact-heading">Have a project in mind?<br /><span>I’d be happy to collaborate.</span></h2>
      <p>Tell me what you’re building and where you’d like help with cloud infrastructure or software delivery.</p>
      <a class="ms-github-link" href={githubUrl} target="_blank" rel="noopener noreferrer">Explore my code on GitHub <span aria-hidden="true">↗</span></a>
    </div>

    <div class="ms-contact-links">
      <a class="ms-contact-link ms-email-link" href={`mailto:${email}`}>
        <span><small>EMAIL</small><strong>{email}</strong></span>
        <span class="ms-link-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="ms-contact-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
        <span><small>LINKEDIN</small><strong>Connect with me</strong></span>
        <span class="ms-link-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ms-contact { background: var(--accent-soft, #edf3ff); border-top: 1px solid var(--line, #dce3ed); padding-block: 68px; }
  .ms-contact-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: 58px; }
  .ms-contact-copy h2 { font-size: clamp(1.8rem, 2.5vw, 2.4rem); line-height: 1.25; letter-spacing: -.035em; margin: 0 0 22px; }
  .ms-contact-copy h2 span { color: var(--accent, #2458cf); }
  .ms-contact-copy > p:last-of-type { color: var(--muted, #536176); font-size: .92rem; line-height: 1.8; max-width: 580px; margin: 0 0 26px; }
  .ms-github-link { display: inline-flex; align-items: center; gap: 10px; color: var(--accent, #2458cf); font-size: .82rem; font-weight: 600; text-decoration: none; }
  .ms-github-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .ms-contact-links { display: grid; gap: 12px; min-width: 0; }
  .ms-contact-link { display: flex; align-items: center; justify-content: space-between; gap: 14px; background: var(--background, #fff); border: 1px solid var(--line, #dce3ed); border-radius: 10px; padding: 21px 24px; color: var(--text, #17263d); text-decoration: none; transition: border-color .18s, transform .18s; }
  .ms-contact-link small { display: block; margin-bottom: 7px; font-family: var(--font-mono, monospace); color: var(--muted, #536176); font-size: .61rem; letter-spacing: .08em; line-height: 1.5; }
  .ms-contact-link strong { display: block; font-size: clamp(1rem, 1.8vw, 1.2rem); font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
  .ms-email-link { background: var(--accent, #2458cf); border-color: var(--accent, #2458cf); color: #fff; }
  .ms-email-link small { color: #e7eeff; }
  .ms-link-arrow { font-size: 1.3rem; flex-shrink: 0; }
  .ms-contact-link:hover { border-color: var(--accent, #2458cf); transform: translateY(-2px); }
  .ms-contact-link:focus-visible, .ms-github-link:focus-visible { outline: 3px solid var(--text, #17263d); outline-offset: 5px; }
  @media (max-width: 800px) {
    .ms-contact { padding-block: 48px; }
    .ms-contact-inner { grid-template-columns: 1fr; gap: 30px; }
    .ms-contact-copy h2 { max-width: 580px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ms-contact-link { transition: none; }
    .ms-contact-link:hover { transform: none; }
  }
</style>
