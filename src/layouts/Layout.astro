---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mohamed Elhabib — DevOps & Cloud Engineer",
  description = "Cloud infrastructure, software delivery and automation. Explore Mohamed Elhabib’s projects and professional experience.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#main" aria-label="MohOps home">
          mohops<span>.</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#experience">Experience</a>
          <a href="#skills">Skills</a>
          <a href="#certifications">Certifications</a>
        
          <a
            class="nav-github"
            href="https://github.com/MedELh-Get"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </nav>

      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="brand" href="#main">mohops<span>.</span></a>
          <p>© {new Date().getFullYear()} Mohamed Elhabib</p>
        </div>

        <a href="#main">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>