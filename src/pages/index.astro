---
import Layout from "../layouts/Layout.astro";
import InfrastructureStories from "../components/InfrastructureStories.astro";

const iconBase =
  "https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons";

const skillGroups = [
  {
    title: "Containers & Kubernetes",
    tools: ["Docker", "Kubernetes", "Helm", "Ingress"],
  },
  {
    title: "Infrastructure & Automation",
    tools: ["Terraform", "Ansible", "Jinja2"],
  },
  {
    title: "CI/CD & GitOps",
    tools: [
      "Git",
      "GitLab CI/CD",
      "GitHub Actions",
      "Jenkins",
      "Argo CD",
    ],
  },
  {
    title: "Systems & Virtualization",
    tools: ["Linux", "Windows", "Proxmox", "KVM/QEMU"],
  },
  {
    title: "Scripting & Development",
    tools: ["Python", "Bash / Shell", "Perl", "JavaScript", "PHP"],
  },
  {
    title: "Networking",
    tools: ["TCP/IP", "NAT / DNAT", "DNS", "DHCP", "OSPF", "BGP"],
  },
  {
    title: "Security & Secrets",
    tools: ["HashiCorp Vault", "SSH", "TLS / SSL", "RBAC"],
  },
  {
    title: "Monitoring",
    tools: ["Prometheus", "Grafana"],
  },
  {
    title: "Web & Application Servers",
    tools: ["NGINX", "HAProxy", "Tomcat"],
  },
  {
    title: "Cloud & Databases",
    tools: [
      "AWS — EC2, S3, IAM",
      "GCP",
      "MySQL",
      "PostgreSQL",
    ],
  },
  {
    title: "Quality & Artifacts",
    tools: ["SonarQube", "JFrog Artifactory"],
  },
  {
    title: "Ways of Working",
    tools: ["Agile", "Jira", "Code review", "Technical documentation"],
  },
];

const technologies = [
  { name: "Linux", icon: "linux/linux-original.svg" },
  { name: "Docker", icon: "docker/docker-original.svg" },
  { name: "Kubernetes", icon: "kubernetes/kubernetes-original.svg" },
  { name: "GitLab CI", icon: "gitlab/gitlab-original.svg" },
  { name: "Argo CD", icon: "argocd/argocd-original.svg" },
  { name: "Terraform", icon: "terraform/terraform-original.svg" },
  { name: "Ansible", icon: "ansible/ansible-original.svg" },
  { name: "Python", icon: "python/python-original.svg" },
];

const projects = [
  {
    number: "01",
    category: "Cloud infrastructure",
    title: "AWS Infrastructure & Deployment Automation",
    description:
      "Provisioning AWS infrastructure with Terraform and configuring an EC2 web server through Ansible and AWS Systems Manager.",
    tools: ["AWS", "Terraform", "Ansible", "GitHub Actions"],
  },
  {
    number: "02",
    category: "Continuous integration",
    title: "Robotics Software Validation",
    description:
      "A C++ CI pipeline combining automated builds, unit tests and a functional test bench to check software behavior against numerical quality gates.",
    tools: ["C++", "CMake", "CTest", "Python"],
  },
  {
    number: "03",
    category: "Code quality & delivery",
    title: "PHP Quality & Delivery Pipeline",
    description:
      "A hands-on delivery project using a self-hosted GitHub Actions runner, SonarQube analysis and packaged build artifacts.",
    tools: ["PHP", "GitHub Actions", "SonarQube", "Docker"],
  },
];

const experiences = [
  {
    company: "Opensee",
    role: "DevOps Engineer",
    start: "2025-02",
    end: "2025-09",
    startLabel: "Feb 2025",
    endLabel: "Sep 2025",
    domain: "Fintech",
    summary:
      "Part of the DevOps team, contributing to delivery automation and reproducible deployments.",
    highlight:
      "Reduced pipeline execution time by approximately 50% through conditional Docker image builds.",
    responsibilities: [
      "Containerized and versioned internal DevOps tools. Built GitLab CI/CD pipelines covering code analysis, linting, security checks, Docker image builds and publication.",
      "Automated deployments with Ansible and implemented GitOps with ArgoCD for approximately five applications across three Kubernetes clusters.",
      "Used Prometheus and Grafana for performance monitoring and incident diagnosis, and HashiCorp Vault for centralized secrets management.",
      "Developed a Python tool to automate backup monitoring across AWS S3 and GCP, with Slack alerts.",
      "Applied Git and CI practices including atomic commits, dedicated branches and merge requests.",
      "Wrote technical documentation covering architecture, deployment and operations.",
    ],
    tools: [
      "GitLab CI/CD",
      "Docker",
      "Kubernetes",
      "ArgoCD",
      "Ansible",
      "HashiCorp Vault",
      "Prometheus",
      "Grafana",
      "Python",
      "Terraform",
      "Debian Linux",
      "AWS S3",
      "GCP",
      "PostgreSQL",
      "ClickHouse",
      "NGINX",
      "HAProxy",
      "DBeaver",
      "Postman",
    ],
  },
  {
    company: "Huawei",
    role: "Cloud Consultant",
    start: "2022-02",
    end: "2024-05",
    startLabel: "Feb 2022",
    endLabel: "May 2024",
    domain: "Telecommunications",
    summary:
      "Provided technical consulting and deployed cloud solutions for telecom operators, supporting the design and production rollout of 5G core services.",
    highlight:
      "Delivered progressive migration from 1,000 to 10,000 users without service interruption.",
    responsibilities: [
      "Deployed and standardized private cloud infrastructure based on OpenStack and Kubernetes to host 5G core services serving more than 10,000 users.",
      "Managed deployment activities from hardware installation through production integration: design review, software deployment, configuration, network integration and service validation.",
      "Automated deployment execution, integration and rollback through scripts, supported by connectivity, network integration and functional validation tests.",
      "Performed phased rollouts and migrations, monitoring metrics during scale-up and supervising services after deployment.",
      "Coordinated installation, infrastructure, networking, integration and maintenance teams during deployments, migrations and operational handovers.",
      "Mentored interns on infrastructure and deployment project activities.",
    ],
    tools: [
      "OpenStack",
      "Kubernetes",
      "Docker",
      "Linux",
      "Ceph",
      "VXLAN",
      "VRF",
      "VLAN",
      "BGP",
      "OSPF",
      "VPN",
      "TCP/IP",
      "Python",
      "Virtualization",
    ],
  },
];
---

<Layout>
  <section class="hero container" aria-labelledby="intro-heading">
    <div class="hero-copy">
      <p class="hero-name">Mohamed Elhabib</p>

      <h1 id="intro-heading">
        DevOps &amp;<br />
        <span>Cloud Engineer.</span>
      </h1>

      <p class="hero-intro">
        I build cloud infrastructure and automate software delivery.
        My experience spans telecom environments at Huawei and DevOps
        engineering at Opensee, where I worked on CI/CD pipelines,
        Kubernetes deployments and monitoring.
      </p>

      <p class="hero-note">
        I enjoy turning manual operations into repeatable processes—and
        understanding what happens when things go wrong.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="#projects">
          View my projects <span aria-hidden="true">↗</span>
        </a>

        <a class="button button-secondary" href="#experience">
          My experience
        </a>
      </div>

      <div class="hero-background">
        <span>Professional background</span>
        <p>Opensee <span aria-hidden="true">/</span> Huawei</p>
      </div>
    </div>

    <InfrastructureStories />
  </section>

  <section class="technology-section" aria-labelledby="technology-heading">
    <div class="container">
      <h2 id="technology-heading" class="technology-heading">
        Technologies I work with
      </h2>

      <ul class="technology-list">
        {
          technologies.map((technology) => (
            <li>
              <img
                src={`${iconBase}/${technology.icon}`}
                alt=""
                aria-hidden="true"
                width="29"
                height="29"
                loading="lazy"
              />
              <span>{technology.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id="about"
    class="section container"
    aria-labelledby="about-heading"
  >
    <div class="about-grid">
      <div class="section-heading">
        <p class="eyebrow">ABOUT ME</p>
        <h2 id="about-heading">Networks, cloud<br />and automation.</h2>
      </div>

      <div class="about-copy">
        <p>
          My background combines networking, cloud infrastructure and
          DevOps. At Huawei, I worked on private cloud deployments
          supporting 5G core services, from infrastructure installation
          and network integration to production rollout. At Opensee,
          I focused on delivery automation, GitOps and platform
          observability.
        </p>

        <p>
          Alongside my professional experience, I build practical projects
          to deepen my skills: provisioning AWS infrastructure with
          Terraform, deploying through Ansible and Systems Manager, and
          testing robotics software through automated CI pipelines.
          This portfolio documents those projects, including the decisions,
          troubleshooting and lessons behind them.
        </p>
      </div>
    </div>
  </section>

  <section
    id="projects"
    class="section section-tinted"
    aria-labelledby="projects-heading"
  >
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">SELECTED PROJECTS</p>
        <h2 id="projects-heading">Engineering through practice.</h2>
        <p>
          Projects exploring infrastructure, automated testing and
          software delivery.
        </p>
      </div>

      <div class="project-grid">
        {
          projects.map((project) => (
            <article class="project-card">
              <div class="project-top">
                <p class="project-category">{project.category}</p>
                <span class="project-number" aria-hidden="true">
                  {project.number}
                </span>
              </div>

              <h3>{project.title}</h3>
              <p class="project-description">{project.description}</p>

              <ul class="tag-list" aria-label="Technologies">
                {project.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="experience"
    class="section container"
    aria-labelledby="experience-heading"
  >
    <div class="section-heading">
      <p class="eyebrow">PROFESSIONAL EXPERIENCE</p>
      <h2 id="experience-heading">Cloud platforms. Production systems.</h2>
      <p>Experience across fintech and telecommunications.</p>
    </div>

    <div class="career-list">
      {
        experiences.map((experience) => (
          <article class="career-entry">
            <div class="career-meta">
              <p class="career-date">
                <time datetime={experience.start}>
                  {experience.startLabel}
                </time>
                {" — "}
                <time datetime={experience.end}>
                  {experience.endLabel}
                </time>
              </p>
              <p class="career-domain">{experience.domain}</p>
            </div>

            <div class="career-content">
              <p class="career-company">{experience.company}</p>
              <h3>{experience.role}</h3>

              <p class="career-summary">{experience.summary}</p>
              <p class="career-highlight">{experience.highlight}</p>

              <details class="career-details">
                <summary>Responsibilities & technical environment</summary>

                <ul class="career-points">
                  {experience.responsibilities.map((item) => <li>{item}</li>)}
                </ul>

                <p class="career-stack-label">Technical environment</p>

                <ul class="tag-list" aria-label="Technical environment">
                  {experience.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </details>
            </div>
          </article>
        ))
      }
    </div>
  </section>
-----
  <section
    id="skills"
    class="section section-tinted"
    aria-labelledby="skills-heading"
  >
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">TECHNICAL SKILLS</p>
        <h2 id="skills-heading">My technical toolkit.</h2>
        <p>
          Technologies used across professional work, personal projects
          and ongoing learning.
        </p>
      </div>
  
      <div class="skills-grid">
        {
          skillGroups.map((group) => (
            <article class="skill-group">
              <h3>{group.title}</h3>
  
              <ul class="tag-list">
                {group.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  
  <section
    id="certifications"
    class="section container"
    aria-labelledby="certifications-heading"
  >
    <div class="section-heading">
      <p class="eyebrow">EDUCATION & LEARNING</p>
      <h2 id="certifications-heading">Education & Certifications.</h2>
      <p>
        Academic qualifications, professional training and current preparation.
      </p>
    </div>
  
    <div class="education-grid">
      <div>
        <h3 class="education-column-title">Education</h3>
  
        <article class="qualification">
          <p class="qualification-date">2024 — 2025</p>
          <h4>Master 2 en Technologies Innovantes</h4>
          <p class="qualification-institution">Université Paris-Saclay</p>
        </article>
  
        <article class="qualification">
          <p class="qualification-date">2019 — 2022</p>
          <h4>Diplôme d’ingénieur en Réseaux et Télécommunications</h4>
          <p class="qualification-institution">ENSA</p>
        </article>
      </div>
  
      <div>
        <h3 class="education-column-title">
          Certifications & Training
        </h3>
  
        <article class="qualification">
          <span class="qualification-status preparation">
            In preparation
          </span>
  
          <h4>Certified Kubernetes Administrator</h4>
          <p class="qualification-institution">CKA</p>
          <p class="qualification-description">
            Practical preparation focused on Kubernetes cluster
            administration, workloads and troubleshooting.
          </p>
        </article>
  
        <article class="qualification">
          <span class="qualification-status">Internal training</span>
          <h4>Cloud Technologies</h4>
          <p class="qualification-institution">Huawei</p>
        </article>
      </div>
    </div>
  
    <div class="personal-details">
      <div>
        <h3>Languages</h3>
        <ul class="language-list">
          <li><span>French</span><strong>C1</strong></li>
          <li><span>English</span><strong>C1</strong></li>
        </ul>
      </div>
  
      <div>
        <h3>Beyond engineering</h3>
        <p>Outside of technology, I enjoy football.</p>
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="closing container">
      <div>
        <p class="eyebrow">CODE & EXPERIMENTS</p>
        <h2>Explore more of my work.</h2>
        <p>Find my repositories and technical projects on GitHub.</p>
      </div>

      <a
        class="button button-primary"
        href="https://github.com/MedELh-Get"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit my GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>