---
import { profile } from "../data/profile";
const linkedinUrl = profile.linkedinUrl.trim();
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="container contact-layout">
    <div>
      <p class="eyebrow">LET’S WORK TOGETHER</p>
      <h2 id="contact-heading">Have a project in mind?<br /><span>I’d be happy to collaborate.</span></h2>
      <p class="contact-intro">
        Tell me what you’re building, what’s getting in the way, and where
        you’d like help with cloud infrastructure or software delivery.
      </p>
      <p class="contact-signature">Mohamed Elhabib <span aria-hidden="true">/</span> mohstack</p>
    </div>
    <div class="contact-actions">
      {linkedinUrl && (
        <a class="button button-primary" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
          <span class="linkedin-mark" aria-hidden="true">in</span>
          Let’s talk on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      )}
      <a class="contact-code" href={profile.githubUrl} target="_blank" rel="noopener noreferrer">
        Explore my code on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section { padding-block: clamp(54px, 7vw, 88px); border-top: 1px solid var(--line); background: var(--accent-soft); }
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .contact-layout h2 { font-size: clamp(1.9rem, 3vw, 2.55rem); line-height: 1.22; }
  .contact-layout h2 span { color: var(--accent); }
  .contact-intro { max-width: 570px; margin-bottom: 24px; color: var(--muted); font-size: .97rem; }
  .contact-signature { margin: 0; font-size: .86rem; font-weight: 600; }
  .contact-signature span { padding-inline: 10px; color: var(--muted); font-weight: 400; }
  .contact-actions { display: flex; flex-direction: column; align-items: flex-start; justify-self: end; gap: 16px; }
  .contact-actions .button { gap: 12px; }
  .linkedin-mark { display: inline-grid; place-items: center; width: 21px; height: 21px; border: 1px solid currentColor; border-radius: 3px; font: bold 15px Arial, sans-serif; }
  .contact-code { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--accent); font-size: .83rem; font-weight: 600; text-underline-offset: 4px; }
  .contact-code:hover { text-decoration: underline; }
  @media (max-width: 800px) {
    .contact-layout { grid-template-columns: 1fr; gap: 26px; }
    .contact-actions { justify-self: start; }
  }
  @media (max-width: 380px) {
    .contact-actions .button { padding-inline: 12px; font-size: .83rem; }
  }
</style>
